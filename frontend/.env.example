# Optional; the defaults are right when the app runs through Caddy (docker compose).

# true = answer every API call from local fixtures (src/data/*.json), no backend needed.
# VITE_USE_FIXTURES=true

# Only if the API is on another origin than the page (e.g. Vite opened directly on :5173;
# then also set CORS_ORIGINS in the root .env). Empty = same origin.
# VITE_API_BASE_URL=http://localhost:8000
