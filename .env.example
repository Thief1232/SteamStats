# Every variable the app needs, in one place.
# Locally: copy to .env (next to docker-compose.yml) and fill in.
# Dokploy: paste the same lines into the Environment tab with production values.

# Public address of the site, with scheme and no trailing slash.
# Steam sign-in returns here; https:// also marks the session cookie Secure.
# Locally: http://localhost:8000. Server: https://<your domain>.
APP_URL=http://localhost:8000

# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Backend database (profiles, libraries, sessions).
BACKEND_DB_USER=steamstats
BACKEND_DB_PASSWORD=
BACKEND_DB_NAME=steamstats

# steamspy-service database (per-game stats cache).
STEAMSPY_DB_USER=steamspy
STEAMSPY_DB_PASSWORD=
STEAMSPY_DB_NAME=steamspy

# Optional. Comma-separated origins allowed to call the backend cross-origin.
# Not needed when everything goes through Caddy (same origin).
# CORS_ORIGINS=http://localhost:5173
