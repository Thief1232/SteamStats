# Routes every request to the right service, locally and on the server alike.
# Plain HTTP on :80 inside the container: locally it is published as localhost:8000,
# on the server Dokploy's Traefik terminates HTTPS in front of it.
# FRONTEND_UPSTREAM: the static build by default, the Vite dev server locally.
:80 {
	encode zstd gzip

	handle /api/games/* {
		reverse_proxy steamspy_service:8081
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /auth/* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy {$FRONTEND_UPSTREAM:frontend:80}
	}
}
